# Boutique — Shopify Storefront API.
# Without these the boutique runs its bundled demo catalog and the pre-launch
# "reserve your bag" flow; with them the same UI shows live products and sends
# the bag to Shopify's hosted checkout. This is the STOREFRONT token (public by
# design, read-only) — never the Admin API key.
VITE_SHOPIFY_DOMAIN=trulys-world.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Products are sorted into the shop by Shopify TAG:
#   zone:racks | zone:records | zone:counter
# and an optional badge:  badge:new | badge:limited | badge:pre-order | badge:signed

# Enter-list — Laylo capture via /api/subscribe (server-only; not VITE_*).
# Defaults in api/subscribe.js match Truly's current drop; set these on Vercel
# only if you need to override. Local Vite alone has no /api — use `vercel dev`
# to exercise the endpoint.
LAYLO_DROP_ID=3r1hv
LAYLO_CREATOR_ID=b8e6f854-9f16-4434-ac5b-6609803e88c2
# Optional secondary sink (Formspree / Sheet webhook). Laylo remains the source of truth.
CAPTURE_WEBHOOK_URL=

# Auth — Supabase email OTP (6-digit codes).
# Create a project, run supabase/migrations/001_init.sql, then set:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# REQUIRED before codes work (otherwise users get a "Sign in" link):
#   Authentication → Email Templates → Magic Link
#   Subject: Your Truly's World code
#   Body: paste supabase/email-templates/magic-link.html
#   Must include {{ .Token }} and must NOT include {{ .ConfirmationURL }}
# Full steps: supabase/AUTH_SETUP.md
#
# Optional: custom SMTP so From says "Truly's World" instead of "Supabase Auth".

# Optional staff gate bypass (server-only). Validated by POST /api/gate-bypass —
# never put this in a VITE_* var or the client bundle.
GATE_BYPASS_CODE=
